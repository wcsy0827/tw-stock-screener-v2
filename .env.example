# L1 篩選門檻（新台幣量級，已用 scripts/calibrate_l1.py 校準，見 filter.py 模組說明）
MIN_PRICE=10
MIN_DAILY_TRADE_VALUE=1000000000
MIN_MARKET_CAP=15000000000
MAX_ATR_PCT=8

# DeepSeek API（L3 AI 精選，見 ranker.py；未設定時自動 fallback 為 L2 分數排序）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 選股設定
MAX_OUTPUT=3
MIN_SCORE=60

# tracker 設定（見 tracker.py 模組說明）
MIN_AI_CONFIDENCE=6
MAX_ACTIVE_POSITIONS=5
